#!/usr/bin/env bash
# Read-only chezmoi status helper: shows pending work both directions with resolve commands.
#
# Key idea: `chezmoi status` columns are NOT two independent jobs.
#   col 1 = last-written-by-chezmoi vs actual ~   → "~ was edited since apply"
#   col 2 = actual ~ vs target (source)           → "apply would change ~"
# When you edit ONLY ~, both columns read M describing the SAME diff (source
# untouched, so last-written == target). Blindly suggesting `apply` off col 2
# would then destroy your ~ edits. We disambiguate `MM` files by cross-checking
# the source repo's git state (uncommitted + incoming-upstream):
#   MM, source clean & no incoming  → only ~ changed   → re-add (apply suppressed)
#   MM, source dirty or incoming    → true 3-way split → CONFLICT (apply/re-add both destructive)
#    M, source dirty                → out-of-band edit → review: keep or discard
#    M, source clean                → deliberate source-ahead → apply is safe

set -uo pipefail

command -v chezmoi >/dev/null 2>&1 || { echo "chez: chezmoi not installed" >&2; exit 1; }

if [[ -t 1 ]]; then
  R=$'\033[0m'; B=$'\033[1m'; D=$'\033[2m'
  G=$'\033[32m'; Y=$'\033[33m'; RED=$'\033[31m'; C=$'\033[36m'
else
  R= B= D= G= Y= RED= C=
fi

SRC=$(chezmoi source-path)
cd "$SRC" || { echo "chez: cannot cd to $SRC" >&2; exit 1; }

# Refresh remote refs so upstream-incoming detection is accurate. Tolerate offline.
git fetch --quiet 2>/dev/null || true

UNCOMMITTED=$(git status --porcelain)
HAS_UP=true
git rev-parse --abbrev-ref --symbolic-full-name '@{u}' >/dev/null 2>&1 || HAS_UP=false
UNPUSHED=""; UNPULLED=""; UP_FILES=""
if $HAS_UP; then
  UNPUSHED=$(git log --oneline '@{u}..HEAD' 2>/dev/null)
  UNPULLED=$(git log --oneline 'HEAD..@{u}' 2>/dev/null)
  UP_FILES=$(git diff --name-only 'HEAD..@{u}' 2>/dev/null)
fi
STATUS=$(chezmoi status 2>/dev/null)

# Source-relative paths with uncommitted edits in the dotfiles repo (strip "XY " prefix).
DIRTY_SRC=$(printf '%s\n' "$UNCOMMITTED" | sed 's/^...//')

in_set() {  # in_set <needle> <newline-list>
  local needle=$1 list=$2 line
  while IFS= read -r line; do [[ "$line" == "$needle" ]] && return 0; done <<< "$list"
  return 1
}

# Classify each status entry into one bucket using the source-side git signal.
REA=""    # ~ edited, safe to capture (re-add); apply would be destructive
CONF=""   # ~ edited AND source/upstream also changed → true 3-way conflict
APPLY=""  # source ahead of ~, committed/deliberate → apply is safe
OOB=""    # source ahead of ~ via uncommitted out-of-band edit (maybe accidental)

while IFS= read -r ln; do
  [[ -z "$ln" ]] && continue
  c1=${ln:0:1}; c2=${ln:1:1}; rel=${ln:3}
  sp=""
  if sp=$(chezmoi source-path "$HOME/$rel" 2>/dev/null); then sp=${sp#$SRC/}; fi
  srcDirty=false; upIn=false
  [[ -n "$sp" ]] && in_set "$sp" "$DIRTY_SRC" && srcDirty=true
  [[ -n "$sp" ]] && in_set "$sp" "$UP_FILES"  && upIn=true

  if [[ "$c1" != " " && "$c2" != " " ]]; then
    # ~ drifted AND differs from target. The MM ambiguity: real conflict only if
    # the source genuinely moved (dirty or incoming). Otherwise it's just the ~ edit.
    if $srcDirty || $upIn; then CONF+="$rel"$'\n'; else REA+="$rel"$'\n'; fi
  elif [[ "$c1" != " " && "$c2" == " " ]]; then
    # ~ drifted but already matches target → source already captures it (re-add refreshes state).
    REA+="$rel"$'\n'
  elif [[ "$c1" == " " && "$c2" != " " ]]; then
    # ~ untouched; source/target ahead.
    if $srcDirty; then OOB+="$rel"$'\n'; else APPLY+="$rel"$'\n'; fi
  fi
done <<< "$STATUS"

if [[ -z "$UNCOMMITTED$UNPUSHED$UNPULLED$STATUS" ]]; then
  echo "${G}✓${R} chezmoi in sync — nothing pending."
  exit 0
fi

echo "${B}${C}chez${R} ${D}— $SRC${R}"

emit_paths() { while IFS= read -r p; do [[ -z "$p" ]] && continue; echo "      ~/$p"; done <<< "$1"; }

# ── True conflicts first: mutually destructive resolutions, highest stakes ──
if [[ -n "$CONF" ]]; then
  echo
  echo "${RED}⚠ CONFLICT (3-way)${R} — ~ edited AND source/upstream also changed:"
  emit_paths "$CONF"
  echo "  ${D}review both sides, then pick ONE per file:${R}"
  while IFS= read -r rel; do [[ -z "$rel" ]] && continue
    echo "    chezmoi diff  ~/$rel        ${D}# source → ~${R}"
    echo "    chezmoi merge ~/$rel        ${D}# reconcile in a 3-way merge${R}"
  done <<< "$CONF"
  echo "  ${D}keep ~:${R}      chezmoi re-add <path>   ${D}# overwrites source with ~${R}"
  echo "  ${D}keep source:${R} chezmoi apply  <path>   ${RED}# discards ~ edits${R}"
fi

# ── Push: ~ edits to capture upstream (apply deliberately NOT suggested here) ──
if [[ -n "$REA" ]]; then
  echo
  echo "${B}↑ Push (local → upstream)${R}"
  echo "  ${Y}●${R} ~ has edits newer than source — capture them:"
  emit_paths "$REA"
  echo "  ${D}suggested:${R}"
  while IFS= read -r rel; do [[ -z "$rel" ]] && continue
    echo "    chezmoi diff   ~/$rel    ${D}# review${R}"
    echo "    chezmoi re-add ~/$rel    ${D}# capture into source${R}"
  done <<< "$REA"
  echo "  ${D}then:${R} chezmoi git add -- <paths> && chezmoi git commit -m \"…\" && chezmoi git push"
fi

if [[ -n "$UNCOMMITTED" ]]; then
  echo
  echo "  ${Y}●${R} uncommitted source changes:"
  echo "$UNCOMMITTED" | sed 's/^/      /'
  echo "  ${D}suggested:${R}"
  echo "    chezmoi git diff"
  echo "    chezmoi git add -- <paths> && chezmoi git commit -m \"…\""
fi

if [[ -n "$UNPUSHED" ]]; then
  echo
  echo "  ${Y}●${R} unpushed commits:"
  echo "$UNPUSHED" | sed 's/^/      /'
  echo "  ${D}suggested:${R} chezmoi git push"
fi

# ── Pull: upstream commits not yet local ──
if [[ -n "$UNPULLED" ]]; then
  echo
  echo "${B}↓ Pull (upstream → local)${R}"
  echo "  ${Y}●${R} incoming commits:"
  echo "$UNPULLED" | sed 's/^/      /'
  if [[ -n "$UP_FILES" ]]; then
    echo "  ${D}files affected:${R}"
    echo "$UP_FILES" | sed 's/^/      /'
  fi
  if [[ -z "$CONF" && -z "$REA" ]]; then
    # Clean incoming: nothing in ~ for a non-interactive apply to clobber, so the
    # one-shot is safe and preferred. `chezmoi update` = git pull --rebase + apply.
    echo "  ${D}suggested:${R} chezmoi update      ${D}# pull --rebase + apply, one step${R}"
  else
    # Local ~ edits (or a true conflict) exist — a blind apply would overwrite them,
    # so split pull from apply and walk the apply by hand.
    echo "  ${D}~ has local edits — pull and apply separately so they aren't clobbered:${R}"
    echo "    chezmoi git pull --rebase       ${D}# fetch + merge in source${R}"
    echo "    chezmoi apply --interactive     ${D}# walk file-by-file${R}"
    [[ -n "$CONF" ]] && echo "  ${RED}note:${R} files in the CONFLICT block above also changed in ~ — resolve those by hand."
  fi
fi

# ── Source ahead of ~ : deliberate (apply) vs out-of-band (review) ──
if [[ -n "$APPLY" || -n "$OOB" ]]; then
  echo
  echo "${B}↻ Source ahead of ~${R} ${D}(apply pushes source → ~)${R}"
  if [[ -n "$APPLY" ]]; then
    emit_paths "$APPLY"
    echo "  ${D}suggested:${R} chezmoi apply --interactive"
  fi
  if [[ -n "$OOB" ]]; then
    echo "  ${Y}⚠ out-of-band source edit (uncommitted — may be accidental):${R}"
    emit_paths "$OOB"
    echo "  ${D}~ is untouched; decide which side is canonical:${R}"
    while IFS= read -r rel; do [[ -z "$rel" ]] && continue
      echo "    chezmoi diff ~/$rel                      ${D}# see the source → ~ change${R}"
    done <<< "$OOB"
    echo "  ${D}keep it:${R} chezmoi apply <path> ${D}then commit${R}"
    echo "  ${D}discard:${R} chezmoi git checkout -- <source-path>   ${D}# revert source to last commit${R}"
  fi
fi

echo
